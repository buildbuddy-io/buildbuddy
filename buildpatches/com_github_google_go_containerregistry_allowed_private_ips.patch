+var allowedPrivateIPs atomic.Pointer[[]*net.IPNet]
+
+// SetAllowedPrivateIPs lets checkRedirectSSRF allow redirects to IP literals
+// in nets. It stores a deep copy, so later changes to nets have no effect.
+func SetAllowedPrivateIPs(nets []*net.IPNet) {
+	copied := make([]*net.IPNet, 0, len(nets))
+	for _, n := range nets {
+		copied = append(copied, &net.IPNet{
+			IP:   append(net.IP(nil), n.IP...),
+			Mask: append(net.IPMask(nil), n.Mask...),
+		})
+	}
+	allowedPrivateIPs.Store(&copied)
+}
+
+func isAllowedPrivateIP(host string) bool {
+	nets := allowedPrivateIPs.Load()
+	if nets == nil {
+		return false
+	}
+	addr, ok := ipaddr.Parse(host)
+	if !ok {
+		return false
+	}
+	ip := net.IP(addr.AsSlice())
+	for _, n := range *nets {
+		if n.Contains(ip) {
+			return true
+		}
+	}
+	return false
+}
+
