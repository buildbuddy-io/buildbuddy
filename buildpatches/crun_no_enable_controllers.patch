--- a/src/libcrun/cgroup-utils.c
+++ b/src/libcrun/cgroup-utils.c
@@ -795,6 +795,18 @@
 static int
 write_controller_file (const char *path, int controllers_to_enable, libcrun_error_t *err)
 {
+  /* BuildBuddy's executor configures cgroup.subtree_control for task cgroups
+     itself, and can leave the cpu controller off so that tasks share CPU per
+     thread. When crun creates a container's cgroup, it calls this function
+     on each ancestor of that cgroup to enable every available controller,
+     which would turn cpu back on. Skip the write and report success.
+
+     Reporting success without enabling anything is safe, because crun only
+     writes controller settings such as cpu.weight for limits in the
+     container's config, and the executor leaves those empty and writes the
+     settings itself.  */
+  return controllers_to_enable;
+
   cleanup_free char *subtree_control = NULL;
   cleanup_free char *controllers = NULL;
   size_t controllers_len = 0;
