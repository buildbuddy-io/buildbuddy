+    # separate recorded input, and Bazel checks recorded inputs in external
+    # repos one Skyframe request at a time, so per-file watches serialize ~200
+    # dependency round trips every time this repo is fetched or looked up in
+    # the remote repo contents cache.
+    if hasattr(ctx, "watch_tree"):
+        ctx.watch_tree(gazelle_dir)
+    else:
+        for src in ctx.attr._go_repository_tools_srcs:
+            watch(ctx, src)
 
