bazel_dep(name = "rules_img", version = "0.3.19")
bazel_dep(name = "rules_img_tool", version = "0.3.19")

register_toolchains("@rules_img_tool//toolchain:all")

bazel_dep(name = "rules_distroless", version = "0.9.4")
archive_override(
    module_name = "rules_distroless",
    integrity = "sha256-9dFC6tHiNx2zP1VpG2q0B3RKusVuuSzndDF2yZJ+dwU=",
    patch_strip = 1,
    patches = ["//buildpatches/bazel_dep:rules_distroless.patch"],
    strip_prefix = "rules_distroless-a9e2012bf5935f7a8fa9c17a768abbbbd135f2a3",
    urls = ["https://github.com/bazel-contrib/rules_distroless/archive/a9e2012bf5935f7a8fa9c17a768abbbbd135f2a3.tar.gz"],
)

# Configure apt for Debian packages
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")

snapshot = "20261102T202832Z"

apt.package_template(
    template_file = "//apt:package.BUILD.tmpl",
    packages = ["*"],
)

apt.sources_list(
    architectures = [
        "amd64",
        "arm64",
    ],
    components = [
        "main",
        "contrib",
    ],
    suites = [
        "trixie",
        "trixie-updates",
    ],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/{}".format(snapshot)],
    gpg_keys = ["//apt/keys:debian-archive-keyring.gpg"],
)
apt.sources_list(
    architectures = [
        "amd64",
        "arm64",
    ],
    components = [
        "main",
        "contrib",
    ],
    suites = ["trixie-security"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian-security/{}".format(snapshot)],
    gpg_keys = ["//apt/keys:debian-archive-keyring.gpg"],
)
apt.sources_list(
    architectures = ["amd64"],
    flat = True,
    suites = ["stable"],
    components = ["main"],
    types = ["deb"],
    uris = ["https://nvidia.github.io/libnvidia-container/stable/deb/amd64"],
    gpg_keys = ["//apt/keys:nvidia-container-toolkit-keyring.gpg"],
)
apt.sources_list(
    architectures = ["arm64"],
    flat = True,
    suites = ["stable"],
    components = ["main"],
    types = ["deb"],
    uris = ["https://nvidia.github.io/libnvidia-container/stable/deb/arm64"],
    gpg_keys = ["//apt/keys:nvidia-container-toolkit-keyring.gpg"],
)
apt.sources_list(
    architectures = [
        "amd64",
        "arm64",
    ],
    components = ["stable"],
    suites = ["trixie"],
    types = ["deb"],
    uris = ["https://download.docker.com/linux/debian"],
    gpg_keys = ["//apt/keys:docker.asc"],
)

# Configure Debian debian13 packages
apt.install(
    dependency_set = "debian13",
    include_transitive = False,
    mergedusr = True,
    packages = [
        # Base system packages
        "base-files",
        "netbase",
        "tzdata",
        "tzdata-legacy",
        "media-types",

        # CA certificates package
        "ca-certificates",

        # base-nossl packages
        "libc6",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
apt.install(
    dependency_set = "debian13",
    include_transitive = True,
    mergedusr = True,
    packages = [
        # executor packages
        "tini",
        "e2fsprogs",
        "fuse3",
        "iproute2",
        "conntrack",
        "amazon-ecr-credential-helper",
        "lxcfs",
        "rootlesskit",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)

DOCKER_VERSION = "5:29.0.1-1~debian.13~trixie"

CONTAINERD_DEB_VERSION = "2.1.5-1~debian.13~trixie"

DOCKER_BUILDX_VERSION = "0.30.0-1~debian.13~trixie"

DOCKER_COMPOSE_VERSION = "2.40.3-1~debian.13~trixie"

# Configure Debian debian13 docker packages
apt.install(
    dependency_set = "debian13",
    include_transitive = True,
    mergedusr = True,
    packages = [
        # docker packages
        "docker-ce (= {})".format(DOCKER_VERSION),
        "docker-ce-cli (= {})".format(DOCKER_VERSION),
        "docker-ce-rootless-extras (= {})".format(DOCKER_VERSION),
        "containerd.io (= {})".format(CONTAINERD_DEB_VERSION),
        "docker-buildx-plugin (= {})".format(DOCKER_BUILDX_VERSION),
        "docker-compose-plugin (= {})".format(DOCKER_COMPOSE_VERSION),
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)

NVIDIA_CONTAINER_TOOLKIT_BASE_VERSION = "1.20.1-1"

# Configure Debian debian13 nvidia_container_toolkit packages
apt.install(
    dependency_set = "debian13",
    include_transitive = True,
    mergedusr = True,
    packages = [
        # nvidia packages
        "nvidia-container-toolkit-base (= {})".format(NVIDIA_CONTAINER_TOOLKIT_BASE_VERSION),
    ],
    suites = [
        "stable",
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "debian13")
