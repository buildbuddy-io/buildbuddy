buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.platform(container_image = "docker://buildpack-deps@sha256:fa56fe73b4475655b2f39d6376b6a6664d24b5c43227f709d4a923609f3286a1")

register_toolchains("@llvm//toolchain:all")

# Specify only the frameworks we actually link
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(names = [
    "CFNetwork",
    "CoreFoundation",
    "CoreServices",
    "DiskArbitration",
    "Foundation",
    "IOKit",
    "Security",
])

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "@com_github_buildbuddy_io_buildbuddy//:go.mod")
go_sdk.nogo(nogo = "@com_github_buildbuddy_io_buildbuddy//:vet")
use_repo(
    go_sdk,
    "go_toolchains",
    "io_bazel_rules_nogo",
)

# Bazel binaries for integration testing
bazel_binaries = use_extension(
    "@rules_bazel_integration_test//:extensions.bzl",
    "bazel_binaries",
    dev_dependency = True,
)
bazel_binaries.download(version = "8.4.2")
use_repo(
    bazel_binaries,
    "bazel_binaries",
    "bazel_binaries_bazelisk",
    "build_bazel_bazel_8_4_2",
)
