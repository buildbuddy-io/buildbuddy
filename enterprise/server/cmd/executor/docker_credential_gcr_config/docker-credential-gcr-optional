#!/bin/sh

# Keep the stock helper's behavior for commands other than credential lookup.
if [ "${1-}" != "get" ]; then
  exec docker-credential-gcr "$@"
fi

# The stock helper authenticates even for public images. When ADC is absent,
# report Docker's standard credentials-not-found error to allow anonymous pulls.
# Keep successful credentials and all other authentication errors unchanged.
if output=$(docker-credential-gcr "$@"); then
  printf '%s\n' "$output"
  exit 0
else
  status=$?
fi

case "$output" in
  *"failed to detect default credentials: credentials: could not find default credentials"*)
    printf '%s\n' 'credentials not found in native keychain'
    exit 1
    ;;
  *)
    printf '%s\n' "$output"
    exit "$status"
    ;;
esac
